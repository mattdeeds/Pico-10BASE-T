;***************************************************
; Title     : Serializer for 10BASE-T
; Date      : 2022/8/12
; Design    : kingyo
;***************************************************

.program ser_10base_t
.side_set 1
.origin 0

; Single-ended Manchester drive into ISL3177E DI (one MCU pin).
; clk 20MHz, input 2 bits = 1 Manchester half-bit period (50ns).
.wrap_target
    out pc, 2  side 0    ; IDLE (DI low — line settles to zero through AC caps)
    out pc, 2  side 0    ; LOW half-bit (DI=0 → ISL drives line negative differential)
    out pc, 2  side 1    ; HIGH half-bit (DI=1 → ISL drives line positive differential)
.wrap

% c-sdk {

    #include "hardware/clocks.h"

    static inline void ser_10base_t_program_init(PIO pio, uint sm, uint offset, uint pin_tx)
    {
        pio_sm_set_pins_with_mask(pio, sm, 0u, 1u << pin_tx);
        pio_sm_set_pindirs_with_mask(pio, sm, ~0u, 1u << pin_tx);
        pio_gpio_init(pio, pin_tx);

        pio_sm_config c = ser_10base_t_program_get_default_config(offset);
        sm_config_set_out_shift(&c, true, true, 32);   // Shift OSR to Right, Autopull is Enable

        sm_config_set_sideset_pins(&c, pin_tx);

        sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

        // Set 20MHz
        float div = (float)clock_get_hz(clk_sys) / (20 * 1000000);
        sm_config_set_clkdiv(&c, div);

        pio_sm_init(pio, sm, offset, &c);
        pio_sm_set_enabled(pio, sm, true);
    }

    static inline void ser_10base_t_tx_10b(PIO pio, uint sm, uint32_t txdata)
    {
        pio_sm_put_blocking(pio, sm, txdata);
    }

%}
